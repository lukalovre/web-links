<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:WebLinks.ViewModels" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:uc="clr-namespace:WebLinks.Views;assembly=WebLinks" mc:Ignorable="d" x:DataType="vm:LinksViewModel" x:Class="WebLinks.Views.LinksView" xmlns:view="using:WebLinks.Views">
	<DockPanel>
		<TabControl>
			<TabItem Header="★">
				<DockPanel>
					<view:GridFilterView DataContext="{Binding GridFilterViewModel}" DockPanel.Dock="Top"/>
					<DataGrid Margin="1" Width="570" ItemsSource="{Binding GridItemsBookmarked}" IsReadOnly="True" GridLinesVisibility="All" BorderThickness="2" BorderBrush="{StaticResource AccentBrush}" SelectedItem="{Binding SelectedGridItem}">
						<DataGrid.Columns>
							<DataGridTextColumn Binding="{Binding Title}" Header="Title" Width="*" />
							<DataGridTextColumn Binding="{Binding Category}" Header="Category" Width="100" />
							<DataGridTextColumn Binding="{Binding LastDate, Converter={StaticResource DaysAgoToStringConverter}}" Header="Ago" Width="70" />
						</DataGrid.Columns>
					</DataGrid>
				</DockPanel>
			</TabItem>
			<TabItem Header="All">
				<DockPanel>
					<view:GridFilterView DataContext="{Binding GridFilterViewModel}" DockPanel.Dock="Top"/>
					<DataGrid Margin="1" Width="570" ItemsSource="{Binding GridItems}" IsReadOnly="True" GridLinesVisibility="All" BorderThickness="2" BorderBrush="{StaticResource AccentBrush}" SelectedItem="{Binding SelectedGridItem}">
						<DataGrid.Columns>
							<DataGridTextColumn Binding="{Binding Title}" Header="Title" Width="*" />
							<DataGridTextColumn Binding="{Binding Category}" Header="Category" Width="100" />
							<DataGridTextColumn Binding="{Binding LastDate, Converter={StaticResource DaysAgoToStringConverter}}" Header="Ago" Width="70" />
						</DataGrid.Columns>
					</DataGrid>
				</DockPanel>
			</TabItem>
		</TabControl>
		<TabControl Margin="5">
			<TabItem Header="Info">
				<ScrollViewer>
					<StackPanel Margin="8" Spacing="12">
						<Border Background="{StaticResource AccentBrush}" CornerRadius="4" Padding="16,14">
							<StackPanel>
								<TextBlock Text="{Binding SelectedItem.Title}" FontSize="22" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" />
								<TextBlock Text="{Binding SelectedItem.Category}" FontSize="12" Foreground="#E8F5E9" Margin="0,5,0,0" />
							</StackPanel>
						</Border>
						<Border Background="#17211B" BorderBrush="#34473A" BorderThickness="1" CornerRadius="4" Padding="10">
							<Grid ColumnDefinitions="*,*">
								<Button Command="{Binding OpenLink}" HorizontalAlignment="Left" Padding="18,8">Open link</Button>
								<Button Command="{Binding Unfollow}" Grid.Column="1" HorizontalAlignment="Right" Padding="18,8">Unfollow</Button>
							</Grid>
						</Border>
						<Border Background="#17211B" BorderBrush="#34473A" BorderThickness="1" CornerRadius="4" Padding="14">
							<Grid ColumnDefinitions="86,*" RowDefinitions="Auto,Auto">
								<TextBlock Text="CATEGORY" FontSize="10" FontWeight="Bold" Foreground="#A8B8AC" />
								<TextBlock Grid.Column="1" Text="{Binding SelectedItem.Category}" Foreground="#F2F7F3" TextWrapping="Wrap" />
								<TextBlock Grid.Row="1" Text="ADDRESS" FontSize="10" FontWeight="Bold" Foreground="#A8B8AC" Margin="0,10,0,0" />
								<TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedItem.Url}" ToolTip.Tip="{Binding SelectedItem.Url}" Foreground="#F2F7F3" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,10,0,0" />
							</Grid>
						</Border>
						<Border Background="#17211B" BorderBrush="#34473A" BorderThickness="1" CornerRadius="4" Padding="8" HorizontalAlignment="Center">
							<Button Command="{Binding OpenImage}" Background="Transparent" BorderThickness="0" Padding="0">
								<Image Source="{Binding Image}" Width="275" Height="275" Stretch="UniformToFill" />
							</Button>
						</Border>
						<view:EventView DataContext="{Binding EventViewModel}" />
					</StackPanel>
				</ScrollViewer>
			</TabItem>
			<TabItem Header="New">
				<ScrollViewer>
					<StackPanel>
						<StackPanel Orientation="Horizontal">
							<Button Command="{Binding AddItemClick}" Margin="15">Add</Button>
							<TextBox PlaceholderText="Paste url" Text="{Binding InputUrl}" Margin="15" />
						</StackPanel>
						<StackPanel>
							<TextBox PlaceholderText="Title" Text="{Binding NewItem.Title}" />
							<TextBox PlaceholderText="Url" Text="{Binding NewItem.Url}" />
							<ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Margin="0,0,0,10"/>
						</StackPanel>
						<Button>
							<Image Source="{Binding NewImage}" />
						</Button>
						<StackPanel Orientation="Horizontal">
							<CheckBox IsChecked="{Binding UseNewDate}" />
							<TextBox Text="{Binding NewDate, Converter={StaticResource DateTimeToStringConverter}, ConverterParameter=yyyy-MM-dd HH:mm:ss}}" Width="200" />
						</StackPanel>
					</StackPanel>
				</ScrollViewer>
			</TabItem>
			<TabItem Header="Edit">
				<ScrollViewer>
					<StackPanel Margin="10">
						<TextBlock Text="ID" />
						<TextBlock Text="{Binding SelectedItem.ID}" Margin="0,0,0,10" />
						<TextBlock Text="Title" />
						<TextBox Text="{Binding SelectedItem.Title}" Margin="0,0,0,10" />
						<TextBlock Text="Url" />
						<TextBox Text="{Binding SelectedItem.Url}" Margin="0,0,0,10" />
						<TextBlock Text="Category" />
						<ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedItem.Category}" Margin="0,0,0,10" />
						<Button Command="{Binding SaveItem}" HorizontalAlignment="Left">Save</Button>
					</StackPanel>
				</ScrollViewer>
			</TabItem>
		</TabControl>
	</DockPanel>
</UserControl>
